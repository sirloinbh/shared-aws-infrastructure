{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UptimeTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic", "sns:DeleteTopic", "sns:GetTopicAttributes", "sns:SetTopicAttributes",
        "sns:ListTagsForResource", "sns:TagResource", "sns:UntagResource",
        "sns:Subscribe", "sns:Unsubscribe", "sns:ListSubscriptionsByTopic",
        "sns:GetSubscriptionAttributes", "sns:SetSubscriptionAttributes"
      ],
      "Resource": [
        "arn:aws:sns:ap-northeast-2:*:sirloinbh-uptime-alerts",
        "arn:aws:sns:ap-northeast-2:*:sirloinbh-uptime-alerts:*"
      ]
    },
    { "Sid": "TopicList", "Effect": "Allow", "Action": "sns:ListTopics", "Resource": "*" },
    {
      "Sid": "UptimeAlarms",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms", "cloudwatch:ListTagsForResource", "cloudwatch:TagResource", "cloudwatch:UntagResource"],
      "Resource": "arn:aws:cloudwatch:ap-northeast-2:*:alarm:sirloinbh-uptime-*"
    },
    { "Sid": "AlarmRead", "Effect": "Allow", "Action": "cloudwatch:DescribeAlarms", "Resource": "*" }
  ]
}
