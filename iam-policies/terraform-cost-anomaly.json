{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CostAnomalyManage",
      "Effect": "Allow",
      "Action": [
        "ce:UpdateAnomalyMonitor", "ce:DeleteAnomalyMonitor",
        "ce:UpdateAnomalySubscription", "ce:DeleteAnomalySubscription",
        "ce:TagResource", "ce:UntagResource", "ce:ListTagsForResource"
      ],
      "Resource": ["arn:aws:ce::*:anomalymonitor/*", "arn:aws:ce::*:anomalysubscription/*"]
    },
    {
      "Sid": "CostAnomalyCreateAndRead",
      "Effect": "Allow",
      "Action": [
        "ce:CreateAnomalyMonitor", "ce:CreateAnomalySubscription",
        "ce:GetAnomalyMonitors", "ce:GetAnomalySubscriptions"
      ],
      "Resource": "*"
    }
  ]
}
